---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: string;
  mp4?: string;
  title: string;
  captions?: string;
  size?: "full" | "medium" | "small";
  maxHeight?: number;
  presentation?: boolean;
}

const { src, mp4, title, captions, size = "full", maxHeight, presentation = false } = Astro.props;

const posters = import.meta.glob<{ default: ImageMetadata }>("../../assets/videos/*-poster.webp", {
  eager: true,
});

const videoName = src
  .split("/")
  .pop()
  ?.replace(/\.[^.]+$/, "");
const posterPath = `../../assets/videos/${videoName}-poster.webp`;
const poster = posters[posterPath]?.default;

if (!poster) {
  throw new Error(`Missing video poster for ${src}. Expected: ${posterPath}`);
}

const sizeClasses = {
  full: "w-full",
  medium: "w-full max-w-[600px]",
  small: "w-full max-w-[300px]",
};
---

<figure class="my-8">
  <div
    class:list={[
      "relative flex w-full items-center justify-center overflow-hidden rounded-lg",
      presentation
        ? "border border-border bg-surface-elevated px-6 py-10 sm:px-12 sm:py-14"
        : "bg-transparent",
    ]}
  >
    <div
      class:list={[
        "project-video-container group relative w-full overflow-hidden rounded-lg border border-border bg-surface",
        sizeClasses[size],
      ]}
      style={{
        aspectRatio: `${poster.width} / ${poster.height}`,
        maxHeight: maxHeight ? `${maxHeight}px` : undefined,
      }}
    >
      <video
        class="project-video absolute inset-0 h-full w-full cursor-pointer object-contain"
        muted
        loop
        playsinline
        preload="none"
        aria-label={`${title}. Press Enter or Space to pause or resume playback.`}
        tabindex="0"
      >
        <source src={src} type="video/webm" />
        {mp4 && <source src={mp4} type="video/mp4" />}
        {captions && <track kind="captions" src={captions} srclang="en" label="English" />}
        Your browser does not support HTML video.
      </video>

      <Image
        src={poster}
        alt=""
        loading="eager"
        fetchpriority="low"
        decoding="async"
        class="project-video-poster pointer-events-none absolute inset-0 h-full w-full object-contain"
      />

      <div
        class="project-video-play-indicator pointer-events-none absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200"
        aria-hidden="true"
      >
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-black/65 text-white">
          <svg
            class="project-video-play-icon h-5 w-5"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M8 5v14l11-7z"></path>
          </svg>
        </div>
      </div>

      <div class="pointer-events-none absolute inset-x-0 bottom-0 h-0.75 bg-black/20">
        <div
          class="project-video-progress h-full w-full origin-left bg-accent"
          style="transform: scaleX(0);"
        ></div>
      </div>
    </div>
  </div>

  <figcaption class="mt-3 text-sm text-secondary">{title}</figcaption>
</figure>

<style>
  .project-video-poster {
    opacity: 1;
    transition: opacity 350ms ease;
  }

  .project-video-container[data-playing="true"] .project-video-poster {
    opacity: 0;
  }

  .project-video-container[data-paused="true"][data-manually-paused="true"]
    .project-video-play-indicator {
    opacity: 1;
  }

  .project-video-container:focus-within {
    outline: 2px solid var(--color-accent);
    outline-offset: 3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-video-poster,
    .project-video-play-indicator {
      transition: none;
    }
  }
</style>

<script>
  function initializeProjectVideos() {
    const videos = document.querySelectorAll<HTMLVideoElement>(".project-video");
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          const video = entry.target as HTMLVideoElement;

          if (!entry.isIntersecting) {
            video.pause();
            continue;
          }

          if (reducedMotion || video.dataset.manuallyPaused === "true") continue;

          video.play().catch(() => {});
        }
      },
      { threshold: 0.25 },
    );

    videos.forEach((video) => {
      if (video.dataset.initialized === "true") return;

      video.dataset.initialized = "true";

      const container = video.closest<HTMLElement>(".project-video-container");
      const progress = container?.querySelector<HTMLElement>(".project-video-progress");

      let animationFrame = 0;
      let bufferingTimeout = 0;

      function updateProgress() {
        if (progress && Number.isFinite(video.duration) && video.duration > 0) {
          progress.style.transform = `scaleX(${video.currentTime / video.duration})`;
        }

        if (!video.paused && !video.ended) {
          animationFrame = requestAnimationFrame(updateProgress);
        }
      }

      function updatePlaybackState() {
        if (container) {
          container.dataset.paused = String(video.paused);
        }
      }

      function showVideo() {
        window.clearTimeout(bufferingTimeout);

        if (container) {
          container.dataset.playing = "true";
        }
      }

      function showPoster() {
        if (container) {
          container.dataset.playing = "false";
        }
      }

      function togglePlayback() {
        if (video.paused) {
          video.dataset.manuallyPaused = "false";

          if (container) {
            container.dataset.manuallyPaused = "false";
          }

          video.play().catch(() => {});
        } else {
          video.dataset.manuallyPaused = "true";

          if (container) {
            container.dataset.manuallyPaused = "true";
          }

          video.pause();
        }
      }

      video.addEventListener("play", () => {
        cancelAnimationFrame(animationFrame);
        updatePlaybackState();
        updateProgress();
      });

      video.addEventListener("playing", () => {
        showVideo();
      });

      video.addEventListener("waiting", () => {
        window.clearTimeout(bufferingTimeout);

        bufferingTimeout = window.setTimeout(() => {
          if (!video.paused) {
            showPoster();
          }
        }, 350);
      });

      video.addEventListener("pause", () => {
        cancelAnimationFrame(animationFrame);
        window.clearTimeout(bufferingTimeout);
        updatePlaybackState();
      });

      video.addEventListener("seeked", () => {
        if (progress && Number.isFinite(video.duration) && video.duration > 0) {
          progress.style.transform = `scaleX(${video.currentTime / video.duration})`;
        }
      });

      video.addEventListener("error", () => {
        window.clearTimeout(bufferingTimeout);
        showPoster();
      });

      video.addEventListener("click", togglePlayback);

      video.addEventListener("keydown", (event) => {
        if (event.key !== "Enter" && event.key !== " ") return;

        event.preventDefault();
        togglePlayback();
      });

      updatePlaybackState();
      observer.observe(video);
    });
  }

  document.addEventListener("astro:page-load", initializeProjectVideos);
</script>
