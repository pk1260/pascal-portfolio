---
import SectionHeading from "../ui/section-heading.astro";
import { ArrowUpRight } from "lucide-astro";

const sectionHeading = {
  eyebrow: "Portfolio / About",
  title: "Beyond the code",
  description: "A little more about the person behind the projects.",
  headingId: "about-preview-heading",
};
---

<section
  id="about-preview"
  aria-labelledby="about-preview-heading"
  class="container-page py-14 md:py-20 lg:py-24 border-b border-border"
>
  <div class="mb-2 flex items-start justify-between gap-6">
    <SectionHeading {...sectionHeading} />
    <span aria-hidden="true" class="hidden font-mono text-xs text-text-secondary md:block">
      02 / 04
    </span>
  </div>

  <div class="grid gap-10 md:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] md:gap-16 lg:gap-24">
    <div class="flex flex-col items-start">
      <p class="max-w-xl text-xl leading-relaxed font-medium text-text-primary md:text-2xl">
        I'm a software engineer with a background in HBO-ICT, interested in building practical
        applications and understanding how systems work.
      </p>

      <p class="mt-5 max-w-xl text-base leading-relaxed text-text-secondary">
        My work spans web, mobile, and desktop development, combining hands-on implementation with
        research and problem-solving.
      </p>
    </div>

    <dl class="flex flex-col justify-center gap-6">
      <div class="border-b border-border pb-5">
        <dt class="mb-2 font-mono text-xs tracking-wide text-text-secondary uppercase">
          Background
        </dt>
        <dd class="text-sm font-medium text-text-primary">HBO-ICT / Software Engineering</dd>
      </div>

      <div class="border-b border-border pb-5">
        <dt class="mb-2 font-mono text-xs tracking-wide text-text-secondary uppercase">
          Development
        </dt>
        <dd class="text-sm font-medium text-text-primary">Web / Mobile / Desktop</dd>
      </div>

      <div>
        <dt class="mb-2 font-mono text-xs tracking-wide text-text-secondary uppercase">Approach</dt>
        <dd class="text-sm font-medium text-text-primary">Research / Building / Improving</dd>
      </div>
    </dl>
  </div>
  <a
    href="/about/"
    class="group mt-8 inline-flex items-center gap-2 font-medium text-accent-text transition-colors hover:text-text-primary focus-visible:rounded-sm focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
  >
    More about me
    <ArrowUpRight size={18} aria-hidden="true" class="transition-transform duration-200" />
  </a>
</section>
