---
import { Image } from "astro:assets";
import tokyoImage from "../../assets/hero/tokyo-night.webp";
import Typewriter from "./typewriter.astro";
---

<section
  aria-labelledby="hero-title"
  class="relative isolate flex min-h-svh items-center overflow-hidden bg-hero-background text-hero-foreground"
>
  <Image
    src={tokyoImage}
    alt=""
    loading="eager"
    fetchpriority="high"
    widths={[640, 960, 1280, 1920, 2400]}
    sizes="100vw"
    class="absolute inset-0 -z-20 h-full w-full object-cover object-[68%_center]"
  />

  <div
    aria-hidden="true"
    class="absolute inset-0 -z-10 bg-linear-to-r from-hero-overlay/85 via-hero-overlay/55 to-hero-overlay/20"
  ></div>

  <div class="container-page relative z-10 py-36 md:py-44">
    <div class="max-w-3xl">
      <h1
        id="hero-title"
        data-hero-reveal="1"
        class="text-[clamp(3.2rem,9vw,8rem)] leading-[0.9] font-black tracking-[-0.055em]"
      >
        <span class="block">PASCAL</span>
        <span class="block">
          KUIPER<span class="text-accent">.</span>
        </span>
      </h1>

      <p
        class="mt-6 text-sm font-medium tracking-[0.12em] text-accent md:text-lg"
        data-hero-reveal="2"
      >
        ソフトウェアエンジニア
      </p>

      <div class="mt-7 border-l-[3px] border-accent pl-5" data-hero-reveal="3">
        <h2 class="text-[clamp(1.65rem,4vw,3.4rem)] leading-[1.05] font-bold tracking-tight">
          <span class="block">I AM</span>
          <Typewriter />
        </h2>
      </div>

      <div class="mt-9 flex flex-wrap items-center gap-5" data-hero-reveal="2">
        <a
          href="/projects"
          class="inline-flex min-h-11 items-center justify-center rounded-sm bg-accent px-6 py-3 text-sm font-bold text-accent-foreground no-underline hover:bg-accent-hover hover:no-underline"
        >
          VIEW MY WORK
          <span aria-hidden="true" class="ml-3">
            ↗
          </span>
        </a>

        <a
          href="/about"
          class="inline-flex min-h-11 items-center border-b border-hero-foreground px-1 text-sm font-medium text-hero-foreground no-underline hover:border-accent hover:no-underline"
        >
          ABOUT ME
        </a>
      </div>
    </div>
  </div>

  <div
    aria-hidden="true"
    class="absolute top-28 left-5 hidden text-xs font-medium tracking-widest text-white lg:block"
  >
    TOKYO / JAPAN
  </div>

  <div
    aria-hidden="true"
    class="absolute top-1/2 right-6 hidden -translate-y-1/2 [writing-mode:vertical-rl] xl:block"
  >
    <span class="text-xs tracking-[0.2em] text-white">DEVELOPMENT / RESEARCH / DESIGN</span>
  </div>

  <div
    aria-hidden="true"
    lang="ja"
    class="pointer-events-none absolute right-12 bottom-12 z-10 hidden text-[clamp(6rem,12vw,12rem)] leading-none font-black tracking-[-0.08em] text-white/20 xl:block"
  >
    東京
  </div>

  <a
    href="#selected-work"
    class="absolute bottom-0 left-1/2 hidden -translate-x-1/2 flex-col items-center gap-3 text-xs tracking-[0.2em] text-white no-underline hover:no-underline md:flex"
  >
    SCROLL
    <span aria-hidden="true" class="h-20 w-px bg-accent"></span>
  </a>
</section>

<style>
  [data-hero-reveal] {
    animation: hero-reveal 650ms ease-out both;
  }

  [data-hero-reveal="1"] {
    animation-delay: 100ms;
  }

  [data-hero-reveal="2"] {
    animation-delay: 220ms;
  }

  [data-hero-reveal="3"] {
    animation-delay: 340ms;
  }

  [data-hero-reveal="4"] {
    animation-delay: 460ms;
  }

  @keyframes hero-reveal {
    from {
      opacity: 0;
      transform: translateY(16px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    [data-hero-reveal] {
      animation: none;
    }
  }
</style>
