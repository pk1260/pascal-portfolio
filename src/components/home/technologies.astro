---
import { Icon } from "astro-icon/components";
import { ArrowUpRight } from "lucide-astro";
import SectionHeading from "../ui/section-heading.astro";

const technologies = [
  { name: "TypeScript", icon: "simple-icons:typescript" },
  { name: "Python", icon: "simple-icons:python" },
  { name: "C++", icon: "simple-icons:cplusplus" },
  { name: "Java", icon: "simple-icons:openjdk" },
  { name: "React", icon: "simple-icons:react" },
  { name: "Astro", icon: "simple-icons:astro" },
  { name: "Expo", icon: "simple-icons:expo" },
  { name: "Django", icon: "simple-icons:django" },
  { name: "Qt", icon: "simple-icons:qt" },
  { name: "Docker", icon: "simple-icons:docker" },
];

const sectionHeading = {
  eyebrow: "Portfolio / Expertise",
  title: "What I work with",
  description: "A selection of languages, frameworks, and tools I've worked with.",
  headingId: "technologies-heading",
};
---

<section
  id="technologies"
  aria-labelledby="technologies-heading"
  class="container-page py-14 md:py-20 lg:py-24 border-b border-border"
>
  <div class="mb-2 flex items-start justify-between gap-6">
    <SectionHeading {...sectionHeading} />
    <span aria-hidden="true" class="hidden font-mono text-xs text-text-secondary md:block">
      03 / 04
    </span>
  </div>
  <ul class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 lg:grid-cols-5">
    {technologies.map((technology) => (
      <li class="flex min-w-0 items-center gap-3 rounded-md border border-border bg-surface px-4 py-3.5">
        <Icon
          name={technology.icon}
          size={24}
          class="shrink-0 text-text-primary"
          aria-hidden="true"
        />

        <span class="min-w-0 text-sm font-medium text-text-primary">{technology.name}</span>
      </li>
    ))}
  </ul>

  <a
    href="/about/#skills"
    class="group mt-8 inline-flex items-center gap-2 font-medium text-accent-text transition-colors hover:text-text-primary"
  >
    Explore all my skills
    <ArrowUpRight size={18} aria-hidden="true" class="transition-transform duration-200" />
  </a>
</section>
