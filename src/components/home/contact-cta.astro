---
import { ArrowUpRight } from "lucide-astro";
import SectionHeading from "../ui/section-heading.astro";

const sectionHeading = {
  eyebrow: "Portfolio / Contact",
  title: "Let's build something",
  headingId: "contact-cta-heading",
};
---

<section
  id="contact-cta"
  aria-labelledby="contact-cta-heading"
  class="container-page py-14 md:py-20 lg:py-24"
>
  <div class="mb-2 flex items-start justify-between gap-6">
    <SectionHeading {...sectionHeading} />
    <span aria-hidden="true" class="hidden font-mono text-xs text-text-secondary md:block">
      04 / 04
    </span>
  </div>

  <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_auto] md:items-end md:gap-16">
    <p class="max-w-xl text-base leading-relaxed text-text-secondary">
      Interested in collaborating, discussing an opportunity, or just getting in touch? I'd love to
      hear from you.
    </p>

    <a
      href="/contact/"
      class="group inline-flex w-fit items-center justify-center gap-3 rounded-md bg-accent px-6 py-3.5 text-sm font-semibold text-accent-foreground transition-colors duration-200 hover:bg-accent-hover focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-accent"
    >
      Get in touch
      <ArrowUpRight size={18} aria-hidden="true" class="transition-transform duration-200" />
    </a>
  </div>
</section>
