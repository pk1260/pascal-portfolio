---
const siteKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY;
---

<form
  id="contact-form"
  action="/api/contact"
  method="POST"
  class="space-y-5 rounded-lg border border-border bg-surface p-6 sm:p-8"
>
  <div class="grid grid-cols-1 gap-5 sm:grid-cols-2">
    <div>
      <label for="contact-name" class="mb-2 block text-sm font-medium text-text-primary">
        Name
      </label>
      <input
        id="contact-name"
        name="name"
        type="text"
        autocomplete="name"
        required
        minlength="2"
        maxlength="100"
        placeholder="Your name"
        class="w-full rounded-sm border border-border bg-background px-4 py-3 text-sm text-text-primary outline-none transition-colors placeholder:text-text-secondary focus:border-accent"
      />
    </div>

    <div>
      <label for="contact-email" class="mb-2 block text-sm font-medium text-text-primary">
        Email address
      </label>
      <input
        id="contact-email"
        name="email"
        type="email"
        autocomplete="email"
        required
        maxlength="254"
        placeholder="you@example.com"
        class="w-full rounded-sm border border-border bg-background px-4 py-3 text-sm text-text-primary outline-none transition-colors placeholder:text-text-secondary focus:border-accent"
      />
    </div>
  </div>

  <div>
    <label for="contact-subject" class="mb-2 block text-sm font-medium text-text-primary">
      Subject <span class="text-text-secondary">(optional)</span>
    </label>
    <input
      id="contact-subject"
      name="subject"
      type="text"
      maxlength="150"
      placeholder="What's this about?"
      class="w-full rounded-sm border border-border bg-background px-4 py-3 text-sm text-text-primary outline-none transition-colors placeholder:text-text-secondary focus:border-accent"
    />
  </div>

  <div>
    <label for="contact-message" class="mb-2 block text-sm font-medium text-text-primary">
      Message
    </label>
    <textarea
      id="contact-message"
      name="message"
      required
      minlength="10"
      maxlength="5000"
      rows="6"
      placeholder="Tell me a little about your message..."
      class="w-full resize-y rounded-sm border border-border bg-background px-4 py-3 text-sm leading-relaxed text-text-primary outline-none transition-colors placeholder:text-text-secondary focus:border-accent"
    ></textarea>
  </div>

  <div aria-hidden="true" class="hidden">
    <label for="contact-website">Website</label>
    <input id="contact-website" name="website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <div id="contact-turnstile" data-sitekey={siteKey}></div>

  <button
    id="contact-submit"
    type="submit"
    disabled
    class="inline-flex items-center gap-3 rounded-sm bg-accent px-6 py-3 text-sm font-semibold text-accent-foreground transition-opacity hover:opacity-85 disabled:cursor-not-allowed disabled:opacity-50"
  >
    <span id="contact-submit-label">Send message</span>
    <span aria-hidden="true">↗</span>
  </button>

  <p id="contact-feedback" role="status" aria-live="polite" class="text-sm text-text-secondary"></p>
</form>

<script>
  type TurnstileAPI = {
    render: (
      element: HTMLElement,
      options: {
        sitekey: string;
        callback?: (token: string) => void;
        "expired-callback"?: () => void;
        "timeout-callback"?: () => void;
        "error-callback"?: (code: string) => boolean;
      },
    ) => string;
    reset: (widgetId: string) => void;
    remove: (widgetId: string) => void;
    getResponse: (widgetId: string) => string | undefined;
  };

  type TurnstileWindow = Window & {
    turnstile?: TurnstileAPI;
  };

  function initializeContactForm() {
    const form = document.querySelector<HTMLFormElement>("#contact-form");
    const container = document.querySelector<HTMLElement>("#contact-turnstile");
    const feedback = document.querySelector<HTMLElement>("#contact-feedback");
    const submit = document.querySelector<HTMLButtonElement>("#contact-submit");
    const submitLabel = document.querySelector<HTMLElement>("#contact-submit-label");

    if (!form || !container || !feedback || !submit || !submitLabel) return;

    let widgetId: string | undefined;
    let verified = false;
    let sending = false;
    let active = true;

    const updateButton = () => {
      submit.disabled = !verified || sending;
      submitLabel.textContent = sending ? "Sending..." : "Send message";
    };

    const setFeedback = (message: string) => {
      feedback.textContent = message;
    };

    const renderTurnstile = () => {
      const api = (window as TurnstileWindow).turnstile;
      const sitekey = container.dataset.sitekey;

      if (!active || !api || !sitekey || widgetId !== undefined) return;

      widgetId = api.render(container, {
        sitekey,
        callback: () => {
          if (!active) return;

          verified = true;
          updateButton();
        },
        "expired-callback": () => {
          if (!active || sending) return;

          verified = false;
          setFeedback("Security verification expired. Please verify again.");
          updateButton();
        },
        "timeout-callback": () => {
          if (!active || sending) return;

          verified = false;
          setFeedback("Security verification timed out. Please try again.");
          updateButton();
        },
        "error-callback": (code) => {
          if (!active || sending) return true;

          verified = false;
          setFeedback("Security verification failed. Please refresh the page and try again.");
          updateButton();

          console.error("Turnstile error:", code);
          return true;
        },
      });
    };

    const loadTurnstile = () => {
      if ((window as TurnstileWindow).turnstile) {
        renderTurnstile();
        return;
      }

      let script = document.querySelector<HTMLScriptElement>("#turnstile-script");

      if (!script) {
        script = document.createElement("script");
        script.id = "turnstile-script";
        script.src = "https://challenges.cloudflare.com/turnstile/v0/api.js?render=explicit";
        script.async = true;
        document.head.appendChild(script);
      }

      script.addEventListener("load", renderTurnstile, { once: true });
    };

    updateButton();
    loadTurnstile();

    form.addEventListener("input", () => {
      if (!sending) {
        setFeedback("");
      }
    });

    form.addEventListener("submit", async (event) => {
      event.preventDefault();

      if (sending) return;

      const api = (window as TurnstileWindow).turnstile;
      const token = widgetId !== undefined ? api?.getResponse(widgetId) : undefined;

      if (!verified || !token) {
        setFeedback("Please complete the security verification.");
        return;
      }

      sending = true;
      setFeedback("");
      updateButton();

      try {
        const body = new URLSearchParams();

        new FormData(form).forEach((value, key) => {
          if (typeof value === "string") {
            body.append(key, value);
          }
        });

        body.set("cf-turnstile-response", token);

        const response = await fetch(form.action, {
          method: "POST",
          headers: {
            "Content-Type": "application/x-www-form-urlencoded",
          },
          body,
        });

        const result = (await response.json()) as { message?: string };

        if (!active) return;

        if (!response.ok) {
          setFeedback(result.message ?? "Unable to send your message. Please try again.");
          return;
        }

        form.reset();
        setFeedback("Your message has been sent successfully. Thank you!");
      } catch {
        if (active) {
          setFeedback("Something went wrong. Please try again.");
        }
      } finally {
        sending = false;
        verified = false;

        if (active) {
          updateButton();

          if (widgetId !== undefined) {
            api?.reset(widgetId);
          }
        }
      }
    });

    document.addEventListener(
      "astro:before-swap",
      () => {
        active = false;

        if (widgetId !== undefined) {
          (window as TurnstileWindow).turnstile?.remove(widgetId);
          widgetId = undefined;
        }
      },
      { once: true },
    );
  }

  document.addEventListener("astro:page-load", initializeContactForm);
</script>
