---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/hero.astro";
import SelectedWork from "../components/home/selected-work.astro";
import AboutPreview from "../components/home/about-preview.astro";
import Technologies from "../components/home/technologies.astro";
import ContactCta from "../components/home/contact-cta.astro";
import { createPersonSchema, createWebsiteSchema } from "../lib/structured-data";

const pageDescription = {
  title: "Pascal Kuiper | Software Engineer",
  description:
    "Explore the portfolio of Pascal Kuiper, a software engineer building web and mobile applications, exploring technologies, and solving real-world problems.",
};

const structuredData = [createPersonSchema(Astro.site!), createWebsiteSchema(Astro.site!)];
---

<BaseLayout
  title={pageDescription.title}
  description={pageDescription.description}
  structuredData={structuredData}
  fullBleed
>
  <Hero />
  <SelectedWork />
  <AboutPreview />
  <Technologies />
  <ContactCta />
</BaseLayout>
