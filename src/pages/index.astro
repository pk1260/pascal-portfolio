---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/hero.astro";
import SelectedWork from "../components/home/selected-work.astro";
import SectionHeading from "../components/ui/section-heading.astro";
---

<BaseLayout title="Pascal Kuiper | Software Engineer" fullBleed>
  <Hero />
  <section id="selected-work" class="container-page py-12 lg:py-24">
    <SectionHeading
      eyebrow="Selected Work"
      title="Projects I've built"
      description="A selection of software projects and technical research."
    />
    <SelectedWork />
  </section>
</BaseLayout>
