---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/home/hero.astro";
import SelectedWork from "../components/home/selected-work.astro";
import SectionHeading from "../components/ui/section-heading.astro";

const pageHeading = {
  eyebrow: "Portfolio / Work",
  title: "Selected work",
  description: "A collection of software projects, technical research, and things I've built.",
};
---

<BaseLayout title="Pascal Kuiper | Software Engineer" fullBleed>
  <Hero />
  <section id="selected-work" class="container-page py-8 lg:py-24">
    <SectionHeading {...pageHeading} />
    <SelectedWork />
  </section>
</BaseLayout>
