---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";
import ProjectCard from "../components/projects/project-card.astro";
import SectionHeading from "../components/ui/section-heading.astro";

const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);

const pageHeading = {
  eyebrow: "Portfolio / Work",
  title: "Selected work",
  description: "A collection of software projects, technical research, and things I've built.",
};
---

<BaseLayout title="Work | Pascal Kuiper">
  <main class="container-page pb-24 md:pb-32">
    <SectionHeading {...pageHeading} level="h1" />

    <div class="mb-8 flex items-center justify-between border-b border-border pb-4">
      <span class="text-xs font-medium tracking-widest text-secondary">
        {String(projects.length).padStart(2, "0")} PROJECTS
      </span>
    </div>

    <section aria-label="Projects" class="grid grid-cols-1 gap-x-8 gap-y-12 md:grid-cols-2">
      {projects.map((project) => (
        <ProjectCard project={project} source="work" />
      ))}
    </section>
  </main>
</BaseLayout>
